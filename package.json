{
  "name": "relay-traffic-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "build": "tsc --noEmit && tsc --project tsconfig.worker.json && vite build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run",
    "cloudflare:secrets": "node --env-file-if-exists=.env --experimental-strip-types scripts/prepare-cloudflare-secrets.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "start:edge": "node --env-file=.env --experimental-strip-types server/index.ts",
    "benchmark:traffic": "node --experimental-strip-types scripts/benchmark-traffic.ts",
    "dev": "vite --host 127.0.0.1 --port 5180",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:worker": "wrangler deploy --dry-run --outdir .wrangler/test-bundle && node --experimental-strip-types --test tests/cloudflare.test.mjs",
    "db:migrate": "node --env-file=.env --experimental-strip-types scripts/migrate-supabase.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.59.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261029.1",
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261023.2-beta",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "wrangler": "4.155.0"
  }
}
