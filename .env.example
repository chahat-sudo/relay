# Supabase browser client (public project URL and publishable key).
# Copy to ignored .env and fill in values from your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only PostgreSQL direct/session-pooler URL, including the database password.
# Required for npm start and npm run db:migrate. Never use a VITE_ prefix here.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# RELAY_DATABASE_CA_FILE=C:/path/to/supabase-ca.crt

# Worker backend: use a separately verified Supabase Session pooler URL on 5432.
# RELAY_WORKER_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres

# Optional ingress: uncomment and set every value together when configuring it.
# Generate a private random key and share it only with your own Worker secret.
# RELAY_PUBLIC_ORIGIN=https://track.example.com
# RELAY_TRACKING_PORT=4181
# RELAY_EDGE_KEYS={"primary":"REPLACE_WITH_GENERATED_SECRET"}
