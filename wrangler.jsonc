{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relay",
  "account_id": "17533b60846d46ca02a4cfd46f37619b",
  "main": "edge/app-worker.ts",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "RELAY_PUBLIC_ORIGIN": "https://relay.chahat.workers.dev"
  },
  "durable_objects": {
    "bindings": [{ "name": "BACKEND", "class_name": "RelayBackend" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayBackend"] }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "64cec2fe41fb4cbbb39dcfcb9e4ce38d" }]
}
