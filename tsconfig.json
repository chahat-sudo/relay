{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "skipLibCheck": true, "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "server", "shared", "edge", "tests", "scripts", "vite.config.ts"]
}
